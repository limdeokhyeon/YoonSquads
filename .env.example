TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Anthropic API key (https://console.anthropic.com/) — enables Claude chat
# for any non-command message sent to the bot. Leave empty to disable.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# NEWS_SOURCE: google (default, no key needed), rss, or naver
NEWS_SOURCE=google

# Used when NEWS_SOURCE=google
NEWS_KEYWORDS=정치,경제,시사

# Used when NEWS_SOURCE=rss
RSS_FEED_URL=https://news.google.com/rss?hl=ko&gl=KR&ceid=KR:ko

# Used when NEWS_SOURCE=naver (발급: https://developers.naver.com/apps)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_NEWS_KEYWORDS=정치,경제,시사
