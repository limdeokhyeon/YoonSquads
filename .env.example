# 비워 두면 로그인된 Claude Code(claude -p, 구독)로 글을 씁니다
ANTHROPIC_API_KEY=
# Instagram 비즈니스/크리에이터 계정 + Graph API 장기 액세스 토큰
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_GRAPH_VERSION=v21.0
CLAUDE_MODEL=claude-sonnet-5-5
# 브랜드 톤 (선택)
BRAND_VOICE=친근하고 따뜻한 말투, 이모지는 2~3개 이내
DB_PATH=queue.db

# 네이버 NAVER API HUB 키 (console.ncloud.com → NAVER API HUB → Application → 인증 정보)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 텔레그램 승인 봇
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 뉴스 수집 설정 (시각은 한국시간)
NEWS_KEYWORDS=정치,경제,시사
DAILY_COUNT=3
COLLECT_HOUR=9
POST_HOURS=12,18,21
# 기사 본문 앞부분(2000자)을 사실 파악용으로 참고 (robots.txt 허용 사이트만, 문장은 옮기지 않음)
FETCH_BODY=false
# 카드 본문 하단 안내 문구 (비우면 표시 안 함)
CARD_FOOTER=※ 보도 내용을 요약한 것으로, 자세한 내용은 출처 기사를 확인하세요
# 카드 이미지를 공개 URL로 올리기 위한 imgbb 키 (api.imgbb.com, 무료)
IMGBB_API_KEY=
# 한글 폰트 경로 (비우면 OS 기본 폰트 자동 탐색)
FONT_PATH=
