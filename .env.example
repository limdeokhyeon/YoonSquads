# BotFather에서 발급한 텔레그램 봇 토큰
TELEGRAM_BOT_TOKEN=
# 게시 권한을 줄 텔레그램 사용자 ID (쉼표로 여러 명). 봇에 /start 를 보내면 내 ID가 표시됨
TELEGRAM_ALLOWED_USER_IDS=

# 인스타그램 비즈니스/크리에이터 계정의 IG User ID (Graph API의 instagram_business_account.id)
INSTAGRAM_USER_ID=
# instagram_content_publish 권한이 있는 장기 액세스 토큰
INSTAGRAM_ACCESS_TOKEN=

# 이 봇이 외부에서 접근 가능한 주소 (Instagram이 이미지를 가져감). 예: https://bot.example.com
PUBLIC_BASE_URL=
# MEDIA_PORT=8080
# INSTAGRAM_GRAPH_VERSION=v21.0
