# 비워 두면 로그인된 Claude Code(claude -p, 구독)로 글을 씁니다
ANTHROPIC_API_KEY=
# Instagram 비즈니스/크리에이터 계정 + Graph API 장기 액세스 토큰
# IGAA...로 시작하는 Instagram 로그인 토큰이면 IG_USER_ID는 비워 둬도 됩니다 (60일마다 자동 갱신)
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_GRAPH_VERSION=v21.0
CLAUDE_MODEL=claude-sonnet-5-5
# 브랜드 톤 (선택)
BRAND_VOICE=친근하고 따뜻한 말투, 이모지는 2~3개 이내
DB_PATH=queue.db

# 네이버 NAVER API HUB 키 (console.ncloud.com → NAVER API HUB → Application → 인증 정보)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 텔레그램 승인 봇
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 뉴스 수집 설정 (시각은 한국시간)
NEWS_KEYWORDS=정치,경제,시사
DAILY_COUNT=3
COLLECT_HOUR=9
POST_HOURS=12,18,21
# 속보 감시: N분마다 검색해 새 속보를 검토 요청으로 보냄 (승인하면 2분 뒤 바로 발행)
BREAKING=false
BREAKING_KEYWORDS=속보
BREAKING_POLL_MINUTES=5
# 속보를 확인할 시간대(한국시간). 9~18이면 09:00부터 18:00까지, 간격이 60분이면 정각마다 확인. 기본은 하루 종일(0~24)
BREAKING_START_HOUR=0
BREAKING_END_HOUR=24
BREAKING_MAX_PER_DAY=5
BREAKING_MAX_AGE_MIN=90
# 기사 본문 앞부분(2000자)을 사실 파악용으로 참고 (robots.txt 허용 사이트만, 문장은 옮기지 않음)
FETCH_BODY=false
# 카드 배경 사진: none(남색 그라데이션) | ai(GPT 이미지, OPENAI_API_KEY 필요·유료) | unsplash(무료 사진, UNSPLASH_ACCESS_KEY 필요)
PHOTO_SOURCE=none
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
# unsplash.com/developers 에서 앱을 만들면 받는 Access Key (데모 한도 시간당 50회)
UNSPLASH_ACCESS_KEY=
# AI 배경일 때 카드 우측 상단에 'AI 생성 이미지' 표시 (실제 사진으로 오해하지 않도록 켜 두길 권장)
AI_LABEL=true
# 카드 이미지를 공개 URL로 올리기 위한 imgbb 키 (api.imgbb.com, 무료)
IMGBB_API_KEY=
# 모든 글에 항상 붙일 계정 고유 해시태그 1개 (예: 나우이슈). 나머지 태그는 최근 글과 겹치지 않게 고릅니다
BRAND_HASHTAG=
# 한글 폰트 경로 (비우면 OS 기본 폰트 자동 탐색)
FONT_PATH=
