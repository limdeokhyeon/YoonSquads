TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Anthropic API key (https://console.anthropic.com/) — enables Claude chat
# for any non-command message sent to the bot. Leave empty to disable.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# NEWS_SOURCE: google (default, no key needed), rss, or naver
NEWS_SOURCE=google

# Used when NEWS_SOURCE=google
NEWS_KEYWORDS=정치,경제,시사

# Used when NEWS_SOURCE=rss
RSS_FEED_URL=https://news.google.com/rss?hl=ko&gl=KR&ceid=KR:ko

# Used when NEWS_SOURCE=naver
# NAVER_API_PROVIDER: developers (developers.naver.com 키, 기본값) / ncp (네이버 클라우드 NAVER API HUB 키)
NAVER_API_PROVIDER=developers
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_NEWS_KEYWORDS=정치,경제,시사

# ---- Instagram 게시 (비워두면 비활성화) ----
# 게시 권한을 줄 텔레그램 사용자 ID (쉼표로 여러 명)
TELEGRAM_ALLOWED_USER_IDS=
# Meta 앱 > Instagram API > Instagram 로그인이 포함된 API 설정 > 계정 추가 후 발급
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=   # instagram_business_content_publish 권한 필요
# Instagram 이 이미지를 가져갈 수 있는 외부 주소 (예: ngrok/cloudflared 터널 주소)
PUBLIC_BASE_URL=
# MEDIA_PORT=8080
# INSTAGRAM_GRAPH_VERSION=v21.0
